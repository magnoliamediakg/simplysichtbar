---
import { SITE } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="border-t-[5px] border-mint bg-grey text-white">
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-6 lg:px-8">
    <div class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
      <div class="space-y-3">
        <a href="/" aria-label="simplysichtbar Startseite" class="inline-block">
          <img
            src="/images/logo_simplysichtbar_white.png"
            alt="simplysichtbar"
            width="160"
            height="54"
            class="h-10 w-auto"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="max-w-sm text-sm leading-relaxed text-white/80">
          Webdesign, lokales SEO &amp; KI-Sichtbarkeit (GEO) für regionale Betriebe in Niederösterreich &amp; Österreich.
        </p>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm text-white/90">
          <a href={SITE.phoneHref} class="transition-colors hover:text-mint">
            {SITE.phoneDisplay}
          </a>
          <a href={`mailto:${SITE.email}`} class="transition-colors hover:text-mint">
            {SITE.email}
          </a>
        </div>
      </div>

      <nav aria-label="Rechtliche Links" class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm font-medium">
        <a href="/agb" class="text-white/90 transition-colors hover:text-mint">AGB</a>
        <a href="/datenschutz" class="text-white/90 transition-colors hover:text-mint">Datenschutz</a>
        <a href="/impressum" class="text-white/90 transition-colors hover:text-mint">Impressum</a>
      </nav>
    </div>

    <div class="mt-10 border-t border-white/15 pt-6 text-xs text-white/70">
      <p>
        &copy; {year} {SITE.name} – ein Angebot der {SITE.legalName}, {SITE.address.street}, {SITE.address.postalCode}{' '}
        {SITE.address.city}. Alle Rechte vorbehalten.
      </p>
    </div>
  </div>
</footer>
